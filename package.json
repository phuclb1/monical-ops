{
  "name": "ops-monical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:reset": "rm -f data/ops.db && echo 'Xóa DB local. Chạy npm run dev để seed lại.'",
    "db:reseed-users": "npx tsx scripts/reseed-users.ts",
    "db:reseed-rooms": "npx tsx scripts/reseed-rooms.ts",
    "db:reseed-ops": "npx tsx scripts/reseed-ops.ts",
    "db:reseed-local": "npx tsx scripts/reseed-local-test.ts",
    "qa:run": "node scripts/qa-run.mjs",
    "qa:e2e": "node scripts/qa-e2e.mjs",
    "qa:run:prd": "QA_RUN_ID=R-$(date -u +%Y%m%d)-prd node scripts/qa-run-prd.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
