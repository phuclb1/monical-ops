{
  "name": "ops-monical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test test/**/*.test.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "NEXT_PUBLIC_APP_URL=https://ops-staging.monicalhoteldalat.com NEXT_PUBLIC_VAPID_PUBLIC_KEY=BB5b4KJ43Tmex5SVN1wDfoBwuyf2g63XM3wMVna9Sm2BEEwwO__XUs9zNKsffkm40zI1cyewYmEIe3IpqQwqeQw opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "db:clone-prod-to-staging": "node scripts/clone-prod-to-staging.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ops-monical --local",
    "db:migrate:prod": "wrangler d1 migrations apply ops-monical --remote",
    "db:migrate:staging": "wrangler d1 migrations apply ops-staging --remote --env staging",
    "db:studio": "drizzle-kit studio --config=drizzle.local.config.ts",
    "db:reset": "rm -f data/ops.db && echo 'Xóa DB local. Chạy npm run dev để seed lại.'",
    "db:reseed-users": "npx tsx scripts/reseed-users.ts",
    "db:reseed-rooms": "npx tsx scripts/reseed-rooms.ts",
    "db:reseed-ops": "npx tsx scripts/reseed-ops.ts",
    "db:reseed-local": "npx tsx scripts/reseed-local-test.ts",
    "qa:run": "node scripts/qa-run.mjs",
    "qa:e2e": "node scripts/qa-e2e.mjs",
    "qa:e2e:staging": "OPS_URL=https://ops-staging.monicalhoteldalat.com OPS_RECEPTION_USER=ngan.lt OPS_HK_USER=uyen.hk QA_RUN_ID=E2E-$(date -u +%Y%m%d)-stg node scripts/qa-e2e.mjs",
    "qa:perf": "node scripts/qa-perf.mjs",
    "qa:perf:staging": "OPS_URL=https://ops-staging.monicalhoteldalat.com QA_RUN_ID=PERF-$(date -u +%Y%m%d)-stg node scripts/qa-perf.mjs",
    "qa:run:prd": "QA_RUN_ID=R-$(date -u +%Y%m%d)-prd node scripts/qa-run-prd.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
